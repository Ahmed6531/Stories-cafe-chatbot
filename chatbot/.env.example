APP_NAME=Stories Cafe Chatbot Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
#test

EXPRESS_API_BASE_URL=http://127.0.0.1:5000

OPENAI_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=models/gemini-2.5-flash

# Google Cloud STT credentials for Speech-to-Text (STT) provider.
# Paste the *entire* service account JSON as a single line (escape newlines), or
# load it into your environment via your secrets manager.
GOOGLE_CREDENTIALS_JSON=your_google_service_account_json_here

# ── Text-to-Speech ────────────────────────────────────────────────
# Set TTS_ENABLED=true to activate Google Cloud TTS on bot replies.
# Uses the same GOOGLE_CREDENTIALS_JSON service account as STT.
# Voice options: en-US-Journey-F (default), en-US-Journey-D (male),
#   en-US-Neural2-F, en-US-Neural2-C
TTS_ENABLED=true
TTS_VOICE=en-US-Journey-F

# Set to "disabled" to run without Redis (in-memory sessions only).
REDIS_URL=disabled
